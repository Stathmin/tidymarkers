    family-names: Ulyanov
    name-particle: Stathmin
    email: uldas1508@gmail.com
    orcid: https://orcid.org/0000-0002-5880-5931
    affiliation: >-
      All-Russian Research Institute of Agricultural Biotechnology (VNIISB),
      Moscow, Russia
keywords:
  - plant breeding
  - marker-assisted selection
  - KASP
  - primer design
  - reproducibility
