#: marker_alignment.R:36 marker_io.R:160 marker_io.R:244
msgid "FASTA not found: {path}"
msgstr "FASTA не найдена: {path}"

#: marker_alignment.R:80
msgid ""
"Haplotype {hap} has an insertion before the reference start; cannot anchor "
"it."
msgstr ""
"У гаплотипа {hap} вставка перед началом референса; невозможно привязать."

#: marker_alignment.R:95
msgid ""
"Haplotype {hap} has a deletion at the reference start; cannot anchor it."
msgstr "У гаплотипа {hap} делеция в начале референса; невозможно привязать."

#: marker_alignment.R:145
msgid "`seqs` must be a DNAStringSet or a character vector."
msgstr "`seqs` должен быть DNAStringSet или символьным вектором."

#: marker_alignment.R:148
msgid "Need at least two sequences to call haplotypes."
msgstr "Для вызова гаплотипов нужны как минимум две последовательности."

#: marker_alignment.R:150
msgid "to align the haplotypes"
msgstr "для выравнивания гаплотипов"

#: marker_alignment.R:155
msgid "`reference` is out of range (1..{length(a)})."
msgstr "`reference` вне диапазона (1..{length(a)})."

#: marker_alignment.R:160
msgid "`reference` = {reference} is not a sequence name."
msgstr "`reference` = {reference} не является именем последовательности."

#: marker_alignment.R:198
msgid "A `freq` table needs `haplotype` and `freq` columns."
msgstr "Таблица `freq` требует колонок `haplotype` и `freq`."

#: marker_alignment.R:209
msgid "A `freq` vector must be named by haplotype."
msgstr "Вектор `freq` должен быть именован по гаплотипу."

#: marker_alignment.R:243
msgid "A `maf` table needs `pos`, `ref`, `alt` and `maf`/`freq`."
msgstr "Таблица `maf` требует `pos`, `ref`, `alt` и `maf`/`freq`."

#: marker_alignment.R:278
msgid "to plot an alignment"
msgstr "для отрисовки выравнивания"

#: marker_alignment.R:280
msgid "`hp` must come from haplotypes_from_alignment()."
msgstr "`hp` должен быть получен из haplotypes_from_alignment()."

#: marker_annotate.R:32
msgid "for structured variant annotation"
msgstr "для структурированной аннотации вариантов"

#: marker_annotate.R:71
msgid "for codon-level annotation"
msgstr "для аннотации на уровне кодонов"

#: marker_annotate.R:101
msgid "for an EnsDb gene model"
msgstr "для генной модели EnsDb"

#: marker_annotate.R:110
msgid "Downloading the Ensembl Plants GTF into {.path {cache}}."
msgstr "Скачиваю GTF Ensembl Plants в {.path {cache}}."

#: marker_annotate.R:116
msgid "Building the EnsDb (one-off) from {.file {fs::path_file(gtf)}}."
msgstr "Собираю EnsDb (однократно) из {.file {fs::path_file(gtf)}}."

#: marker_arms.R:243
msgid "tetra-primer ARMS is implemented for single-base substitutions only."
msgstr "тетра-праймерный ARMS реализован только для однонуклеотидных замен."

#: marker_arms.R:253
msgid "No outer primer pair passed the Tm/GC filters."
msgstr "Ни одна внешняя пара праймеров не прошла фильтры Tm/GC."

#: marker_arms.R:261
msgid "No inner allele-specific primer passed the GC/Tm filter."
msgstr "Ни один внутренний аллель-специфичный праймер не прошёл фильтр GC/Tm."

#: marker_arms.R:274
msgid "An inner primer is missing on one strand."
msgstr "Внутренний праймер отсутствует на одной из цепей."

#: marker_arms.R:321
msgid "No tetra-primer set cleared even the relaxed constraints."
msgstr "Ни один набор тетра-праймеров не прошёл даже ослабленные ограничения."

#: marker_arms.R:418
msgid "to draw the ARMS gel"
msgstr "для отрисовки геля ARMS"

#: marker_arms.R:420
msgid "`marker` must be a marker_arms object (see design_arms_marker())."
msgstr "`marker` должен быть объектом marker_arms (см. design_arms_marker())."

#: marker_assemble.R:201 marker_assemble.R:210
msgid "No AS primer passed the GC/Tm filter."
msgstr "Ни один AS-праймер не прошёл фильтр GC/Tm."

#: marker_assemble.R:228
msgid "No AS primer passed the homopolymer/SSR filter."
msgstr "Ни один AS-праймер не прошёл фильтр гомополимеров/SSR."

#: marker_assemble.R:241
msgid "No indel AS primer passed the GC/Tm filter."
msgstr "Ни один AS-праймер для индела не прошёл фильтр GC/Tm."

#: marker_assemble.R:245
msgid "No indel AS primer passed the homopolymer/SSR filter."
msgstr "Ни один AS-праймер для индела не прошёл фильтр гомополимеров/SSR."

#: marker_assemble.R:325
msgid "No ALT primer's 3' code is the consensus of every ALT."
msgstr "3'-код ни одного ALT-праймера не является консенсусом всех ALT."

#: marker_assemble.R:377
msgid ""
"No AS primer survived the footprint cap (max_footprint_variants = "
"{max_footprint_variants})."
msgstr ""
"Ни один AS-праймер не выдержал лимит футпринта (max_footprint_variants = "
"{max_footprint_variants})."

#: marker_assemble.R:414
msgid "No AS primer survived even the relaxed constraints."
msgstr "Ни один AS-праймер не прошёл даже ослабленные ограничения."

#: marker_assemble.R:435
msgid ""
"Target SNP {snp$chrom}:{snp$pos} has {best_as$n_3p} other variant(s) in the "
"AS 3'-terminal {clean_3p} nt."
msgstr ""
"У целевого SNP {snp$chrom}:{snp$pos} в 3'-концевых {clean_3p} нт AS-праймера "
"есть {best_as$n_3p} других вариант(ов)."

#: marker_assemble.R:437
msgid ""
"Allele specificity on strand {best_as$strand} may not hold across accessions."
msgstr ""
"Аллельная специфичность на цепи {best_as$strand} может не сохраняться между "
"образцами."

#: marker_assemble.R:442
msgid "AS primer overlaps {best_as$n_var} other variant(s) in its footprint."
msgstr ""
"AS-праймер перекрывает {best_as$n_var} других вариант(ов) под своим "
"футпринтом."

#: marker_assemble.R:443
msgid "No candidate with fewer passed the GC/Tm/discrimination filters."
msgstr ""
"Ни один кандидат с меньшим числом не прошёл фильтры GC/Tm/дискриминации."

#: marker_assemble.R:449
msgid ""
"Best AS primer discrimination = {round(best_as$discrimination, 2)} is below "
"min_disc = {min_disc}."
msgstr ""
"Дискриминация лучшего AS-праймера = {round(best_as$discrimination, 2)} ниже "
"min_disc = {min_disc}."

#: marker_assemble.R:451
msgid "Consider widening `strands` or `tm_range`."
msgstr "Рассмотрите расширение `strands` или `tm_range`."

#: marker_assemble.R:467
msgid ""
"Design at {snp$chrom}:{snp$pos} relies on linkage ({n_link} linked "
"variant(s) in the AS zone)."
msgstr ""
"Дизайн в {snp$chrom}:{snp$pos} держится на сцеплении ({n_link} сцепленных "
"вариантов в зоне AS)."

#: marker_assemble.R:469
msgid ""
"The ALT primer is valid only in accessions carrying the linked haplotype."
msgstr ""
"ALT-праймер действителен только в образцах с этим сцепленным гаплотипом."

#: marker_assemble.R:595
msgid ""
"OligoArrayAux was not found: thermodynamic and structural checks will be NA."
msgstr ""
"OligoArrayAux не найден: термодинамические и структурные проверки будут NA."

#: marker_assemble.R:596
msgid "run tidymarkers::marker_install_tools() once to build it."
msgstr ""
"выполните tidymarkers::marker_install_tools() один раз, чтобы собрать его."

#: marker_assemble.R:735
msgid "No candidate assay survived even the relaxed constraints."
msgstr "Ни один кандидатный ассей не прошёл даже ослабленные ограничения."

#: marker_assemble.R:785
msgid ""
"No screened pairing is genome-specific (an off-target hit, a second product "
"or an inverted repeat)."
msgstr ""
"Ни одна проверенная пара не является геном-специфичной (off-target хит, "
"второй продукт или инвертированный повтор)."

#: marker_assemble.R:792
msgid ""
"Top-ranked pairing failed genome-level checks; kept the next clean one "
"({win} of {n_screen} screened)."
msgstr ""
"Топовая пара не прошла геномные проверки; взята следующая чистая ({win} из "
"{n_screen} просмотренных)."

#: marker_assemble.R:794
msgid ""
"Ranking is genome-free; off-target hits, in-silico PCR and inverted repeats "
"are screened here."
msgstr ""
"Ранжирование не использует геном; здесь проверяются off-target хиты, ПЦР in "
"silico и инвертированные повторы."

#: marker_assemble.R:822
msgid "in-silico PCR failed: {conditionMessage(e)}"
msgstr "ПЦР in silico не удалась: {conditionMessage(e)}"

#: marker_assemble.R:835
msgid "FM scan failed: {conditionMessage(e)}"
msgstr "Сканирование FM не удалось: {conditionMessage(e)}"

#: marker_assemble.R:841
msgid "BLAST db unavailable: {conditionMessage(e)}"
msgstr "BLAST-БД недоступна: {conditionMessage(e)}"

#: marker_assemble.R:885
msgid "genome ideogram failed: {conditionMessage(e)}"
msgstr "построение идеограммы генома не удалось: {conditionMessage(e)}"

#: marker_assemble.R:919 marker_assemble.R:928
msgid ""
"Target {snp$chrom}:{snp$pos} is multi-allelic ({out$site$n_alt[1L]} ALTs, "
"class {out$site$class[1L]})."
msgstr ""
"Мишень {snp$chrom}:{snp$pos} мультиаллельная ({out$site$n_alt[1L]} ALT, "
"класс {out$site$class[1L]})."

#: marker_assemble.R:922
msgid ""
"The ALT primer is degenerate (3' base {out$site$code[1L]}): it covers every "
"ALT but cannot tell them apart."
msgstr ""
"ALT-праймер вырожденный (3'-основание {out$site$code[1L]}): он покрывает все "
"ALT, но не различает их."

#: marker_assemble.R:931
msgid ""
"The ALT primer is built for {snp$alt} only; the other ALTs are not covered."
msgstr "ALT-праймер построен только для {snp$alt}; остальные ALT не покрыты."

#: marker_assemble.R:942
#, fuzzy
#| msgid "FM scan failed: {conditionMessage(e)}"
msgid "The acceptance checks could not be evaluated: {conditionMessage(e)}"
msgstr "Сканирование FM не удалось: {conditionMessage(e)}"

#: marker_assemble.R:943
msgid "assay$evaluation is NULL; the verdict is unknown, not usable."
msgstr ""

#: marker_assemble.R:959
msgid ""
"The chosen assay fails structural/specificity checks: {paste(bad, collapse = "
"'; ')}."
msgstr ""
"Выбранный тест не проходит проверки структуры/специфичности: {paste(bad, "
"collapse = '; ')}."

#: marker_assemble.R:961
msgid ""
"Selection does not gate these yet - inspect assay$evaluation and consider a "
"trade-off."
msgstr ""
"Отбор их пока не гейтит — посмотрите assay$evaluation и рассмотрите "
"компромисс."

#: marker_caps.R:144
msgid "Bundled restriction-enzyme catalogue not found."
msgstr "Встроенный каталог ферментов рестрикции не найден."

#: marker_caps.R:291
msgid "dCAPS scanning is implemented for single-base substitutions only."
msgstr "Поиск dCAPS реализован только для однонуклеотидных замен."

#: marker_caps.R:638
msgid ""
"CAPS: no population haplotypes supplied; restriction-site frequency/"
"conservation is not checked."
msgstr ""

#: marker_caps.R:660
msgid "No natural or primer-introduced (dCAPS) restriction marker here."
msgstr ""
"Здесь нет ни природного, ни вносимого праймером (dCAPS) рестрикционного "
"маркера."

#: marker_caps.R:733
msgid "to draw the CAPS gel"
msgstr "для отрисовки геля CAPS"

#: marker_caps.R:735
msgid "`marker` must be a marker_caps object (see design_caps_marker())."
msgstr "`marker` должен быть объектом marker_caps (см. design_caps_marker())."

#: marker_castpcr.R:255
msgid "castPCR is implemented for single-base substitutions only."
msgstr "castPCR реализован только для однонуклеотидных замен."

#: marker_castpcr.R:270
msgid "No allele-specific primer passed the GC/Tm filters for castPCR."
msgstr ""
"Ни один аллель-специфичный праймер не прошёл фильтры GC/Tm для castPCR."

#: marker_castpcr.R:383
msgid ""
"No mutant allele-specific primer, common mate, probe and WT blocker passed "
"the castPCR filters."
msgstr ""
"Ни один аллель-специфичный праймер к мутанту, общий партнёр, проба и WT-"
"блокер не прошли фильтры castPCR."

#: marker_chunk.R:50
msgid "A list source must come from haplotypes_from_alignment()."
msgstr "Источник-список должен быть получен из haplotypes_from_alignment()."

#: marker_chunk.R:58
msgid "A chunk from a table needs a `reference` sequence."
msgstr "Чанк из таблицы требует последовательности `reference`."

#: marker_chunk.R:68
msgid "A table source needs `pos`/`ref`/`alt`, or `haplotype`/`freq`."
msgstr "Источник-таблица требует `pos`/`ref`/`alt` или `haplotype`/`freq`."

#: marker_chunk.R:77
msgid "`reference` must be one of the alignment's sequence names."
msgstr ""
"`reference` должен быть одним из имён последовательностей выравнивания."

#: marker_chunk.R:131
msgid "The window {from}..{to} is outside the reference (1..{nchar(ref)})."
msgstr "Окно {from}..{to} вне референса (1..{nchar(ref)})."

#: marker_chunk.R:219
msgid "`chunk` must be a marker_chunk (see marker_chunk())."
msgstr "`chunk` должен быть объектом marker_chunk (см. marker_chunk())."

#: marker_core.R:175
msgid "`{nm}` must be a single finite number."
msgstr ""

#: marker_core.R:179
msgid "Salt, dNTP and DMSO concentrations cannot be negative."
msgstr ""

