msgid "Or use specificity_seed() on an in-memory genome."
msgstr "Либо используйте specificity_seed() на геноме в памяти."

#: marker_scan.R:109
msgid "Could not open a BLAST database at {db_path} (build it with marker_blast_index())."
msgstr "Не удалось открыть BLAST-БД по пути {db_path} (постройте её через marker_blast_index())."

#: marker_scan.R:165
msgid "This indexed genome has no BLAST database attached."
msgstr "У этого индексного генома нет прикреплённой BLAST-БД."

#: marker_scan.R:166
msgid "Build one with marker_blast_index(genome) and pass it as `blast_db=`."
msgstr "Постройте её через marker_blast_index(genome) и передайте как `blast_db=`."

#: marker_schemes.R:126
msgid "Unknown specificity mode {mode} for scheme {scheme}."
msgstr "Неизвестный режим специфичности {mode} для схемы {scheme}."

