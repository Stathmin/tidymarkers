msgid "`variants` needs `chrom` and `pos` columns."
msgstr "`variants` требует колонки `chrom` и `pos`."

#: marker_screen.R:204
msgid "`screen` is empty."
msgstr "`screen` пуст."

#: marker_search_anim.R:300
msgid "Design-search animation written to {.path {path}} ({length(pngs)} frames)."
msgstr "Анимация поиска дизайна записана в {.path {path}} ({length(pngs)} кадр(ов))."

#: marker_search_anim.R:332
msgid "No GIF assembler available (ImageMagick not found)."
msgstr "Нет сборщика GIF (ImageMagick не найден)."

#: marker_search_anim.R:333
msgid "Install it: apt-get install imagemagick (Debian/Ubuntu), brew install imagemagick (macOS)."
msgstr "Установите его: apt-get install imagemagick (Debian/Ubuntu), brew install imagemagick (macOS)."

#: marker_search_anim.R:334
msgid "Or assemble the `pngs` yourself (e.g. with gifski)."
msgstr "Либо соберите `pngs` сами (например, через gifski)."

