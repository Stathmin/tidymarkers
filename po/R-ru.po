msgid "The SNaPshot candidate failed a hard gate (extension placement, composition or uniqueness)."
msgstr "Кандидат SNaPShot не прошёл жёсткий гейт (размещение удлинения, состав или уникальность)."

#: marker_solve.R:143
msgid "`plan` must be a marker_plan (see marker_plan())."
msgstr "`plan` должен быть объектом marker_plan (см. marker_plan())."

#: marker_solve.R:147
msgid "The plan has no targets; add them with marker_targets()."
msgstr "В плане нет мишеней; добавьте их через marker_targets()."

#: marker_solve.R:212 marker_solve.R:243 marker_tubes.R:144
msgid "`solved` must be a marker_solved (see marker_solve())."
msgstr "`solved` должен быть объектом marker_solved (см. marker_solve())."

