#: marker_alignment.R:36 marker_io.R:160 marker_io.R:244
msgid "FASTA not found: {path}"
msgstr "FASTA не найдена: {path}"

#: marker_alignment.R:80
msgid "Haplotype {hap} has an insertion before the reference start; cannot anchor it."
msgstr "У гаплотипа {hap} вставка перед началом референса; невозможно привязать."

#: marker_alignment.R:95
msgid "Haplotype {hap} has a deletion at the reference start; cannot anchor it."
msgstr "У гаплотипа {hap} делеция в начале референса; невозможно привязать."

#: marker_alignment.R:145
msgid "`seqs` must be a DNAStringSet or a character vector."
msgstr "`seqs` должен быть DNAStringSet или символьным вектором."

#: marker_alignment.R:148
msgid "Need at least two sequences to call haplotypes."
msgstr "Для вызова гаплотипов нужны как минимум две последовательности."

#: marker_alignment.R:150
msgid "to align the haplotypes"
msgstr "для выравнивания гаплотипов"

#: marker_alignment.R:155
msgid "`reference` is out of range (1..{length(a)})."
msgstr "`reference` вне диапазона (1..{length(a)})."

#: marker_alignment.R:160
msgid "`reference` = {reference} is not a sequence name."
msgstr "`reference` = {reference} не является именем последовательности."

#: marker_alignment.R:198
msgid "A `freq` table needs `haplotype` and `freq` columns."
msgstr "Таблица `freq` требует колонок `haplotype` и `freq`."

#: marker_alignment.R:209
msgid "A `freq` vector must be named by haplotype."
msgstr "Вектор `freq` должен быть именован по гаплотипу."

#: marker_alignment.R:243
msgid "A `maf` table needs `pos`, `ref`, `alt` and `maf`/`freq`."
msgstr "Таблица `maf` требует `pos`, `ref`, `alt` и `maf`/`freq`."

#: marker_alignment.R:278
msgid "to plot an alignment"
msgstr "для отрисовки выравнивания"

#: marker_alignment.R:280
msgid "`hp` must come from haplotypes_from_alignment()."
msgstr "`hp` должен быть получен из haplotypes_from_alignment()."

#: marker_annotate.R:32
msgid "for structured variant annotation"
msgstr "для структурированной аннотации вариантов"

#: marker_annotate.R:71
msgid "for codon-level annotation"
msgstr "для аннотации на уровне кодонов"

#: marker_annotate.R:101
msgid "for an EnsDb gene model"
msgstr "для генной модели EnsDb"

#: marker_annotate.R:110
msgid "Downloading the Ensembl Plants GTF into {.path {cache}}."
msgstr "Скачиваю GTF Ensembl Plants в {.path {cache}}."

#: marker_annotate.R:116
msgid "Building the EnsDb (one-off) from {.file {fs::path_file(gtf)}}."
msgstr "Собираю EnsDb (однократно) из {.file {fs::path_file(gtf)}}."

#: marker_arms.R:165
msgid "tetra-primer ARMS is implemented for single-base substitutions only."
msgstr "тетра-праймерный ARMS реализован только для однонуклеотидных замен."

#: marker_arms.R:175
msgid "No outer primer pair passed the Tm/GC filters."
msgstr "Ни одна внешняя пара праймеров не прошла фильтры Tm/GC."

#: marker_arms.R:183
msgid "No inner allele-specific primer passed the GC/Tm filter."
msgstr "Ни один внутренний аллель-специфичный праймер не прошёл фильтр GC/Tm."

#: marker_arms.R:196
msgid "An inner primer is missing on one strand."
msgstr "Внутренний праймер отсутствует на одной из цепей."

#: marker_arms.R:238
msgid "No tetra-primer set cleared even the relaxed constraints."
msgstr "Ни один набор тетра-праймеров не прошёл даже ослабленные ограничения."

#: marker_arms.R:297
msgid "to draw the ARMS gel"
msgstr "для отрисовки геля ARMS"

#: marker_arms.R:299
msgid "`marker` must be a marker_arms object (see design_arms_marker())."
msgstr "`marker` должен быть объектом marker_arms (см. design_arms_marker())."

#: marker_assemble.R:196
msgid "No AS primer passed the GC/Tm filter."
msgstr "Ни один AS-праймер не прошёл фильтр GC/Tm."

#: marker_assemble.R:214
msgid "No AS primer passed the homopolymer/SSR filter."
msgstr "Ни один AS-праймер не прошёл фильтр гомополимеров/SSR."

#: marker_assemble.R:226
msgid "No indel AS primer passed the GC/Tm filter."
msgstr "Ни один AS-праймер для индела не прошёл фильтр GC/Tm."

#: marker_assemble.R:230
msgid "No indel AS primer passed the homopolymer/SSR filter."
msgstr "Ни один AS-праймер для индела не прошёл фильтр гомополимеров/SSR."

#: marker_assemble.R:310
msgid "No ALT primer's 3' code is the consensus of every ALT."
msgstr "3'-код ни одного ALT-праймера не является консенсусом всех ALT."

#: marker_assemble.R:358
msgid "No AS primer survived the footprint cap (max_footprint_variants = {max_footprint_variants})."
msgstr "Ни один AS-праймер не выдержал лимит футпринта (max_footprint_variants = {max_footprint_variants})."

#: marker_assemble.R:395
msgid "No AS primer survived even the relaxed constraints."
msgstr "Ни один AS-праймер не прошёл даже ослабленные ограничения."

#: marker_assemble.R:416
msgid "Target SNP {snp$chrom}:{snp$pos} has {best_as$n_3p} other variant(s) in the AS 3'-terminal {clean_3p} nt."
msgstr "У целевого SNP {snp$chrom}:{snp$pos} в 3'-концевых {clean_3p} нт AS-праймера есть {best_as$n_3p} других вариант(ов)."

#: marker_assemble.R:418
msgid "Allele specificity on strand {best_as$strand} may not hold across accessions."
msgstr "Аллельная специфичность на цепи {best_as$strand} может не сохраняться между образцами."

#: marker_assemble.R:423
msgid "AS primer overlaps {best_as$n_var} other variant(s) in its footprint."
msgstr "AS-праймер перекрывает {best_as$n_var} других вариант(ов) под своим футпринтом."

#: marker_assemble.R:424
msgid "No candidate with fewer passed the GC/Tm/discrimination filters."
msgstr "Ни один кандидат с меньшим числом не прошёл фильтры GC/Tm/дискриминации."

#: marker_assemble.R:430
msgid "Best AS primer discrimination = {round(best_as$discrimination, 2)} is below min_disc = {min_disc}."
msgstr "Дискриминация лучшего AS-праймера = {round(best_as$discrimination, 2)} ниже min_disc = {min_disc}."

#: marker_assemble.R:432
msgid "Consider widening `strands` or `tm_range`."
msgstr "Рассмотрите расширение `strands` или `tm_range`."

#: marker_assemble.R:448
msgid "Design at {snp$chrom}:{snp$pos} relies on linkage ({n_link} linked variant(s) in the AS zone)."
msgstr "Дизайн в {snp$chrom}:{snp$pos} держится на сцеплении ({n_link} сцепленных вариантов в зоне AS)."

#: marker_assemble.R:450
msgid "The ALT primer is valid only in accessions carrying the linked haplotype."
msgstr "ALT-праймер действителен только в образцах с этим сцепленным гаплотипом."

#: marker_assemble.R:573
msgid "OligoArrayAux was not found: thermodynamic and structural checks will be NA."
msgstr "OligoArrayAux не найден: термодинамические и структурные проверки будут NA."

#: marker_assemble.R:574
msgid "run tidymarkers::marker_install_tools() once to build it."
msgstr "выполните tidymarkers::marker_install_tools() один раз, чтобы собрать его."

#: marker_assemble.R:711
msgid "No candidate assay survived even the relaxed constraints."
msgstr "Ни один кандидатный ассей не прошёл даже ослабленные ограничения."

#: marker_assemble.R:761
msgid "No screened pairing is genome-specific (an off-target hit, a second product or an inverted repeat)."
msgstr "Ни одна проверенная пара не является геном-специфичной (off-target хит, второй продукт или инвертированный повтор)."

#: marker_assemble.R:768
msgid "Top-ranked pairing failed genome-level checks; kept the next clean one ({win} of {n_screen} screened)."
msgstr "Топовая пара не прошла геномные проверки; взята следующая чистая ({win} из {n_screen} просмотренных)."

#: marker_assemble.R:770
msgid "Ranking is genome-free; off-target hits, in-silico PCR and inverted repeats are screened here."
msgstr "Ранжирование не использует геном; здесь проверяются off-target хиты, ПЦР in silico и инвертированные повторы."

#: marker_assemble.R:798
msgid "in-silico PCR failed: {conditionMessage(e)}"
msgstr "ПЦР in silico не удалась: {conditionMessage(e)}"

#: marker_assemble.R:811
msgid "FM scan failed: {conditionMessage(e)}"
msgstr "Сканирование FM не удалось: {conditionMessage(e)}"

#: marker_assemble.R:817
msgid "BLAST db unavailable: {conditionMessage(e)}"
msgstr "BLAST-БД недоступна: {conditionMessage(e)}"

#: marker_assemble.R:861
msgid "genome ideogram failed: {conditionMessage(e)}"
msgstr "построение идеограммы генома не удалось: {conditionMessage(e)}"

#: marker_assemble.R:895 marker_assemble.R:904
msgid "Target {snp$chrom}:{snp$pos} is multi-allelic ({out$site$n_alt[1L]} ALTs, class {out$site$class[1L]})."
msgstr "Мишень {snp$chrom}:{snp$pos} мультиаллельная ({out$site$n_alt[1L]} ALT, класс {out$site$class[1L]})."

#: marker_assemble.R:898
msgid "The ALT primer is degenerate (3' base {out$site$code[1L]}): it covers every ALT but cannot tell them apart."
msgstr "ALT-праймер вырожденный (3'-основание {out$site$code[1L]}): он покрывает все ALT, но не различает их."

#: marker_assemble.R:907
msgid "The ALT primer is built for {snp$alt} only; the other ALTs are not covered."
msgstr "ALT-праймер построен только для {snp$alt}; остальные ALT не покрыты."

#: marker_assemble.R:927
msgid "The chosen assay fails structural/specificity checks: {paste(bad, collapse = '; ')}."
msgstr "Выбранный тест не проходит проверки структуры/специфичности: {paste(bad, collapse = '; ')}."

#: marker_assemble.R:929
msgid "Selection does not gate these yet - inspect assay$evaluation and consider a trade-off."
msgstr "Отбор их пока не гейтит — посмотрите assay$evaluation и рассмотрите компромисс."

#: marker_caps.R:144
msgid "Bundled restriction-enzyme catalogue not found."
msgstr "Встроенный каталог ферментов рестрикции не найден."

#: marker_caps.R:291
msgid "dCAPS scanning is implemented for single-base substitutions only."
msgstr "Поиск dCAPS реализован только для однонуклеотидных замен."

#: marker_caps.R:617
msgid "No natural or primer-introduced (dCAPS) restriction marker here."
msgstr "Здесь нет ни природного, ни вносимого праймером (dCAPS) рестрикционного маркера."

#: marker_caps.R:653
msgid "to draw the CAPS gel"
msgstr "для отрисовки геля CAPS"

#: marker_caps.R:655
msgid "`marker` must be a marker_caps object (see design_caps_marker())."
msgstr "`marker` должен быть объектом marker_caps (см. design_caps_marker())."

#: marker_castpcr.R:249
msgid "castPCR is implemented for single-base substitutions only."
msgstr "castPCR реализован только для однонуклеотидных замен."

#: marker_castpcr.R:262
msgid "No allele-specific primer passed the GC/Tm filters for castPCR."
msgstr "Ни один аллель-специфичный праймер не прошёл фильтры GC/Tm для castPCR."

#: marker_castpcr.R:372
msgid "No mutant allele-specific primer, common mate, probe and WT blocker passed the castPCR filters."
msgstr "Ни один аллель-специфичный праймер к мутанту, общий партнёр, проба и WT-блокер не прошли фильтры castPCR."

#: marker_chunk.R:50
msgid "A list source must come from haplotypes_from_alignment()."
msgstr "Источник-список должен быть получен из haplotypes_from_alignment()."

#: marker_chunk.R:58
msgid "A chunk from a table needs a `reference` sequence."
msgstr "Чанк из таблицы требует последовательности `reference`."

#: marker_chunk.R:68
msgid "A table source needs `pos`/`ref`/`alt`, or `haplotype`/`freq`."
msgstr "Источник-таблица требует `pos`/`ref`/`alt` или `haplotype`/`freq`."

#: marker_chunk.R:77
msgid "`reference` must be one of the alignment's sequence names."
msgstr "`reference` должен быть одним из имён последовательностей выравнивания."

#: marker_chunk.R:131
msgid "The window {from}..{to} is outside the reference (1..{nchar(ref)})."
msgstr "Окно {from}..{to} вне референса (1..{nchar(ref)})."

#: marker_chunk.R:219
msgid "`chunk` must be a marker_chunk (see marker_chunk())."
msgstr "`chunk` должен быть объектом marker_chunk (см. marker_chunk())."

#: marker_core.R:122
msgid "OligoArrayAux ('{bin}') was not found."
msgstr "OligoArrayAux ('{bin}') не найден."

#: marker_core.R:137
msgid "OligoArrayAux ('{bin}') could not be run: {conditionMessage(run)}"
msgstr "OligoArrayAux ('{bin}') не удалось запустить: {conditionMessage(run)}"

#: marker_core.R:142
msgid "OligoArrayAux ('{bin}') exited with status {run$status}: {trimws(run$stderr)}"
msgstr "OligoArrayAux ('{bin}') завершился со статусом {run$status}: {trimws(run$stderr)}"

#: marker_core.R:149
msgid "OligoArrayAux ('{bin}') returned no parsable dG (got '{tok}')."
msgstr "OligoArrayAux ('{bin}') вернул неразбираемое значение dG (получено '{tok}')."

#: marker_core.R:513
msgid "Downloading TAIR10 genome (~35 MB) from Ensembl Plants into {.path {cache}} ..."
msgstr "Скачиваю геном TAIR10 (~35 МБ) из Ensembl Plants в {.path {cache}} ..."

#: marker_core.R:521
msgid "Dropping {length(dropped)} non-chromosome sequence(s), e.g. {.val {utils::head(dropped, 3L)}}."
msgstr "Отбрасываю {length(dropped)} нехромосомную(ые) последовательность(и), напр. {.val {utils::head(dropped, 3L)}}."

#: marker_core.R:531
msgid "ath_genome(): TAIR10 FASTA is missing chromosome(s): {paste(missing, collapse = ', ')}."
msgstr "ath_genome(): в FASTA TAIR10 нет хромосом: {paste(missing, collapse = ', ')}."

#: marker_core.R:533
msgid "Ensembl deflines may have changed."
msgstr "Возможно, изменились дефлайны Ensembl."

#: marker_crispr.R:276
msgid "No guide spacer passed the PAM / seed / specificity / GC filters with a pre-amplification pair."
msgstr "Ни один спейсер гайда не прошёл фильтры PAM/seed/специфичности/GC вместе с преамплификационной парой."

#: marker_decision.R:250
msgid "for the decision graph"
msgstr "для графа решения"

#: marker_decision.R:309
msgid "to draw the decision tree"
msgstr "для отрисовки дерева решений"

#: marker_design.R:77
msgid "No common primer passed the filters."
msgstr "Ни один общий праймер не прошёл фильтры."

#: marker_design.R:78
msgid "Widen `tm_range`/GC or increase `flank` in snp_template()."
msgstr "Расширьте `tm_range`/GC или увеличьте `flank` в snp_template()."

#: marker_design.R:210
msgid "every `alt` allele must be as long as `ref`"
msgstr "каждый аллель `alt` должен быть той же длины, что и `ref`"

#: marker_design.R:464
msgid "design_as_primers_indel() needs unequal alleles; use design_as_primers() for a substitution."
msgstr "design_as_primers_indel() требует аллели разной длины; для замены используйте design_as_primers()."

#: marker_design.R:521
msgid "No indel AS-primer placement fit inside the design window."
msgstr "Ни одно размещение AS-праймера для индела не уместилось в окно дизайна."

#: marker_dpcr.R:171
msgid "dPCR allelic discrimination is implemented for single-base substitutions only."
msgstr "Аллельная дискриминация dPCR реализована только для однонуклеотидных замен."

#: marker_dpcr.R:189
msgid "No flanking primer pair passed the Tm/GC filters for dPCR."
msgstr "Ни одна фланкирующая пара праймеров не прошла фильтры Tm/GC для dPCR."

#: marker_dpcr.R:194
msgid "No hydrolysis probe passed the composition/Tm filters for dPCR."
msgstr "Ни одна гидролизующая проба не прошла фильтры состава/Tm для dPCR."

#: marker_dpcr.R:276
msgid "The dPCR candidate failed a hard gate (probe composition, specificity, Tm ordering or primer Tm)."
msgstr "Кандидат dPCR не прошёл жёсткий гейт (состав пробы, специфичность, порядок Tm или Tm праймеров)."

#: marker_duplex.R:346
msgid "`loci` must have exactly two rows for a duplex assay."
msgstr "`loci` должен содержать ровно две строки для дуплексного ассея."

#: marker_duplex.R:373
msgid "Duplex pairing accepted only after relaxing a soft compatibility cap."
msgstr "Дуплексная пара принята только после ослабления мягкого предела совместимости."

#: marker_duplex.R:375
#, c-format
msgid "relaxed: %s"
msgstr "ослаблено: %s"

#: marker_fm.R:35 marker_fm.R:77
msgid "for the FM-index genome scan"
msgstr "для сканирования генома по FM-индексу"

#: marker_fm.R:38
msgid "Reusing the existing FM-index at {.path {basename}}."
msgstr "Использую существующий FM-индекс в {.path {basename}}."

#: marker_fm.R:49
msgid "Building a Subread FM-index at {.path {basename}} (one-off)."
msgstr "Строю FM-индекс Subread в {.path {basename}} (однократно)."

#: marker_fm.R:78
msgid "to read the alignments"
msgstr "для чтения выравниваний"

#: marker_genome.R:75
msgid "for a BSgenome genome source"
msgstr "для источника генома BSgenome"

#: marker_genome.R:77
msgid "for the BSgenome genome source"
msgstr "для источника генома BSgenome"

#: marker_genome.R:150 marker_genome.R:175
msgid "Unknown sequence: {chrom}"
msgstr "Неизвестная последовательность: {chrom}"

#: marker_haplotypes.R:29
msgid "`haplotypes` is missing column(s): {paste(missing, collapse = ', ')}."
msgstr "В `haplotypes` нет столбца(ов): {paste(missing, collapse = ', ')}."

#: marker_haplotypes.R:45
msgid "`freq` must be one value in [0, 1] per haplotype."
msgstr "`freq` должен быть одним значением в [0, 1] на гаплотип."

#: marker_hrm.R:187
msgid "No short flanking primer pair in the HRM amplicon window passed the Tm/GC filters."
msgstr "Ни одна короткая фланкирующая пара в окне ампликона HRM не прошла фильтры Tm/GC."

#: marker_hrm.R:234
msgid "`marker` must be a marker_hrm object (see design_hrm_marker())."
msgstr "`marker` должен быть объектом marker_hrm (см. design_hrm_marker())."

#: marker_indel_size.R:146
msgid "Not an InDel size polymorphism: `ref` and `alt` are the same length."
msgstr "Это не полиморфизм длины индела: `ref` и `alt` одной длины."

#: marker_indel_size.R:154
msgid "The REF/ALT size difference is below `min_gap`; use capillary/PAGE or a longer indel."
msgstr "Разница размеров REF/ALT меньше `min_gap`; используйте капиллярный электрофорез/ПААГ или более длинный индел."

#: marker_indel_size.R:171
msgid "No flanking primer pair passed the Tm/GC/amplicon filters for this InDel."
msgstr "Ни одна фланкирующая пара праймеров не прошла фильтры Tm/GC/ампликон для этого индела."

#: marker_indel_size.R:214 marker_sanger.R:449
msgid "No flanking pair has unique 3' ends (every candidate's 3' seed repeats in the genome)."
msgstr "Ни у одной фланкирующей пары нет уникальных 3'-концов (3'-сид каждого кандидата повторяется в геноме)."

#: marker_indel_size.R:216
msgid "No flanking pair passed the InDel-size gates (gap, windows, structure, uniqueness)."
msgstr "Ни одна фланкирующая пара не прошла гейты InDel-size (разрыв, окна, структура, уникальность)."

#: marker_io.R:62
msgid "VCF not found: {path}"
msgstr "VCF не найден: {path}"

#: marker_io.R:91
msgid "to read large VCF files"
msgstr "для чтения больших VCF"

#: marker_io.R:94
msgid "{path} has no '#CHROM' header line."
msgstr "В {path} нет строки заголовка '#CHROM'."

#: marker_io.R:120
msgid "for the readVcf backend"
msgstr "для бэкенда readVcf"

#: marker_io.R:159
msgid "for indexed FASTA random access"
msgstr "для произвольного доступа к индексированной FASTA"

#: marker_io.R:163
msgid "Decompressing {.file {fs::path_file(path)}} for indexing (one-off)."
msgstr "Распаковываю {.file {fs::path_file(path)}} для индексации (однократно)."

#: marker_io.R:218
msgid "Bundled example data not found."
msgstr "Встроенные примеры данных не найдены."

#: marker_lamp.R:471
msgid "No LAMP primer set passed the variant-placement / inner-Tm / structure / cross-dimer / amplicon filters."
msgstr "Ни один набор праймеров LAMP не прошёл фильтры размещения варианта/внутренней Tm/структуры/кросс-димеров/ампликона."

#: marker_lax.R:390
msgid "No ALT haplotype carries the target allele; nothing to design."
msgstr "Ни один ALT-гаплотип не несёт целевой аллель; проектировать нечего."

#: marker_lax.R:441
msgid "no ALT primer covers {n_uncovered} ALT haplotype(s)"
msgstr "ни один ALT-праймер не покрывает {n_uncovered} ALT-гаплотип(ов)"

#: marker_lax.R:444
msgid "the wild type also carries a baked linked allele (leakage {round(leakage, 2)})"
msgstr "дикий тип тоже несёт впечатанный сцепленный аллель (утечка {round(leakage, 2)})"

#: marker_lax.R:447
msgid "{n_cross} haplotype-group pairs cross-prime"
