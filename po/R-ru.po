msgstr "`...` должны быть именованными стоимостями, напр. marker_costs(hrm = 1.2)."

#: marker_plan.R:273
msgid "Only marker_*() layers (marker_targets(), marker_context(), marker_tech()) can be added to a marker_plan."
msgstr "К marker_plan можно добавлять только слои marker_*() (marker_targets(), marker_context(), marker_tech())."

#: marker_plan.R:308
msgid "Unknown scheme(s) in the plan: {paste(unknown, collapse = ', ')}; see marker_schemes()."
msgstr "Неизвестная схема(ы) в плане: {paste(unknown, collapse = ', ')}; см. marker_schemes()."

#: marker_rpa.R:341
msgid "RPA discrimination here is implemented for single-base substitutions only."
msgstr "Различение аллелей методом RPA реализовано только для однонуклеотидных замен."

#: marker_rpa.R:390
msgid "No RPA primer pair passed the variant-placement / length / structure / amplicon filters."
msgstr "Ни одна пара праймеров RPA не прошла фильтры размещения варианта/длины/структуры/ампликона."

#: marker_rprimer.R:31
msgid "`seqs` must be equal length (an ungapped alignment)."
msgstr "`seqs` должны быть одинаковой длины (выравнивание без гэпов)."

#: marker_rprimer.R:58
