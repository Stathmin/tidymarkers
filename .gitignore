# -- all ignored files, so a stray print() in a test cannot dirty the tree -----
.Rbuildignore

# book build output
_book/
docs/_book/
*.epub

# pkgdown / site output
_site/
docs/reference/
docs/articles/
pkgdown/
inst/doc/*.html

# RStudio / editor / OS
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj.user
.DS_Store
.Trash-*
Thumbs.db
*~
*.swp
*.swo

# test + check artefacts
*.Rcheck/
*.tar.gz
revdep/
tests/testthat/_snaps/**/*.new.md
tests/testthat/Rplots.pdf

# renv / packrat
renv/library/
renv/staging/
renv/python/
packrat/lib*/
packrat/src/

# local tool builds (OligoArrayAux for UNAFOLDDAT; see dev/README.md)
.tools/
.tmp-rt/
.deps/
.i18n-lib/

# julia / duckdb / compiled
*.jl.cov
*.jl.so
*.so
*.dll
*.dylib
src/*.o
src/*.o.tmp
src/*.so
src/*.dll

# knitr / quarto caches
*_cache/
*_files/
*.utf8.md
*.knit.md
.cache/

# python sidecars (graphify, tool builds)
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# graphify output
graphify-out/

# local test logs and timings (machine-specific; see dev/README.md)
dev/logs/

# fetched literature and probe scratch (never committed); the science pass
# and the roadmap snapshot each added this block, and .tmp/ is shared by both
.tmp/
.tmp-probe*
